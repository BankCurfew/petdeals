#!/usr/bin/env bash
# Repo-specific pre-commit gates for petdeals.
# Called by the fleet hook (~/.oracle/git-hooks/pre-commit) via chaining.
# The fleet hook runs its secret scan BEFORE this file — do not duplicate it.

REPO="$(git rev-parse --show-toplevel)"

# T142 dash ban (em-dash / en-dash / double-hyphen)
if [[ -f "$REPO/scripts/dash-gate.js" ]]; then
  node "$REPO/scripts/dash-gate.js" || exit 1
fi

# T608 fleet scope guard — src/ + oracle-prose in one commit.
# Lives in scripts/ and is CALLED from this chain. It arrived on 2026-08-17 as a
# drop-in .githooks/pre-commit, which silently replaced this chain and killed the
# gate(s) above for ~40 minutes. A gate that installs by overwriting the file that
# holds the other gates removes protection while reporting that it added some.
if [[ -x "$REPO/scripts/scope-guard.sh" ]]; then
  "$REPO/scripts/scope-guard.sh" || exit 1
fi
